generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MarketStatus {
  ACTIVE
  INACTIVE
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  ARTICLE
  GUIDE
  BROKER_REVIEW
  BROKER_COMPARISON
  BEST_BROKER_LIST
  COUNTRY_HUB
  TOPIC_HUB
  GLOSSARY_TERM
  LANDING_PAGE
}

enum TemplateKind {
  ARTICLE
  GUIDE
  BROKER_REVIEW
  BROKER_COMPARISON
  BEST_BROKER_LIST
  COUNTRY_HUB
  TOPIC_HUB
  GLOSSARY_TERM
  LANDING_PAGE
}

enum BrokerStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AffiliateLinkStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum RobotsIndex {
  INDEX
  NOINDEX
}

model Market {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  countryCode  String?
  languageCode String
  locale       String
  timezone     String?
  isGlobal     Boolean      @default(false)
  status       MarketStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  affiliateLinks AffiliateLink[]
  categories     Category[]
  contentItems   ContentItem[]
  seoMetadata    SeoMetadata[]
  topics         Topic[]

  @@index([languageCode])
  @@index([status])
}

model Template {
  id                String       @id @default(cuid())
  key               String       @unique
  name              String
  kind              TemplateKind
  description       String?
  requiredBlocks    Json         @default("[]")
  allowedBlocks     Json         @default("[]")
  schemaTypes       Json         @default("[]")
  ctaSlots          Json         @default("[]")
  internalLinkSlots Json         @default("[]")
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  contentItems ContentItem[]

  @@index([kind])
  @@index([isActive])
}

model Category {
  id          String   @id @default(cuid())
  marketId    String
  parentId    String?
  slug        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  market         Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  parent         Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]    @relation("CategoryTree")
  primaryContent ContentItem[] @relation("PrimaryContentCategory")
  contentItems   ContentItem[] @relation("ContentCategories")

  @@unique([marketId, slug])
  @@index([marketId, parentId])
}

model Topic {
  id          String   @id @default(cuid())
  marketId    String
  parentId    String?
  slug        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  market         Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  parent         Topic?        @relation("TopicTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Topic[]       @relation("TopicTree")
  primaryContent ContentItem[] @relation("PrimaryContentTopic")
  contentItems   ContentItem[] @relation("ContentTopics")

  @@unique([marketId, slug])
  @@index([marketId, parentId])
}

model ContentItem {
  id                String        @id @default(cuid())
  marketId          String
  templateId        String
  primaryCategoryId String?
  primaryTopicId    String?
  title             String
  slug              String
  contentType       ContentType
  status            ContentStatus @default(DRAFT)
  summary           String?
  body              Json          @default("{}")
  canonicalPath     String
  authorName        String?
  reviewerName      String?
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  market          Market            @relation(fields: [marketId], references: [id], onDelete: Restrict)
  template        Template          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  primaryCategory Category?         @relation("PrimaryContentCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  primaryTopic    Topic?            @relation("PrimaryContentTopic", fields: [primaryTopicId], references: [id], onDelete: SetNull)
  brokers         Broker[]          @relation("ContentBrokers")
  categories      Category[]        @relation("ContentCategories")
  revisions       ContentRevision[]
  seoMetadata     SeoMetadata?
  topics          Topic[]           @relation("ContentTopics")

  @@unique([marketId, contentType, slug])
  @@unique([canonicalPath])
  @@index([marketId, status])
  @@index([contentType])
  @@index([publishedAt])
}

model ContentRevision {
  id             String        @id @default(cuid())
  contentItemId  String
  revisionNumber Int
  title          String
  summary        String?
  body           Json          @default("{}")
  status         ContentStatus
  createdBy      String?
  createdAt      DateTime      @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, revisionNumber])
  @@index([contentItemId, createdAt])
}

model SeoMetadata {
  id            String      @id @default(cuid())
  marketId      String
  contentItemId String?     @unique
  brokerId      String?
  title         String
  description   String
  canonicalPath String
  robotsIndex   RobotsIndex @default(INDEX)
  robotsFollow  Boolean     @default(true)
  hreflang      Json        @default("{}")
  schemaJson    Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  market      Market       @relation(fields: [marketId], references: [id], onDelete: Cascade)
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  broker      Broker?      @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@unique([brokerId, marketId])
  @@unique([canonicalPath])
  @@index([marketId])
}

model Broker {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  legalName    String?
  websiteUrl   String?
  logoUrl      String?
  logoAssetKey String?
  description  String?
  status       BrokerStatus @default(DRAFT)
  facts        Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  affiliateLinks AffiliateLink[]
  contentItems   ContentItem[]   @relation("ContentBrokers")
  seoMetadata    SeoMetadata[]

  @@index([status])
}

model AffiliateLink {
  id             String              @id @default(cuid())
  brokerId       String
  marketId       String
  languageCode   String              @default("en")
  campaign       String
  destinationUrl String
  trackingParams Json                @default("{}")
  status         AffiliateLinkStatus @default(DRAFT)
  priority       Int                 @default(100)
  sponsored      Boolean             @default(true)
  nofollow       Boolean             @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([brokerId, marketId, languageCode, campaign, priority])
  @@index([brokerId, marketId, campaign, status])
  @@index([languageCode])
  @@index([startsAt, endsAt])
}
