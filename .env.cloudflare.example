CLOUDFLARE_API_TOKEN="paste-token-here"
CLOUDFLARE_ACCOUNT_ID="paste-account-id-here-if-needed"

# Preview runtime values. Keep secrets out of git and set them with Wrangler secret commands.
APP_ENV="preview"
APP_URL="https://content-hub-cms-preview.<your-subdomain>.workers.dev"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="content-hub-media-preview"
S3_PUBLIC_BASE_URL="https://media-preview.example.com"
MEDIA_MAX_UPLOAD_BYTES="8388608"
MEDIA_UPLOAD_URL_TTL_SECONDS="300"
MEDIA_ALLOWED_ORIGINS="https://content-hub-cms-preview.<your-subdomain>.workers.dev"

# Required Cloudflare secrets:
# DATABASE_URL
# AUTH_PASSWORD_PEPPER
# AUTH_ENCRYPTION_KEY
# S3_ACCESS_KEY_ID
# S3_SECRET_ACCESS_KEY
