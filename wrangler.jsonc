{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "content-hub-cms",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://marketgb.com"
  },
  "routes": [
    {
      "pattern": "marketgb.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "env": {
    "preview": {
      "name": "content-hub-cms-preview",
      "vars": {
        "APP_ENV": "preview",
        "APP_URL": "https://content-hub-cms-preview.content-hub-stack.workers.dev"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    }
  }
}
