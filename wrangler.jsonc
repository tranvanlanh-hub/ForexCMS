{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "content-hub-cms",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "content-hub-cms-db",
      "database_id": "eae75038-5bc2-4024-afd4-bcd660dfd753"
    }
  ],
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "env": {
    "preview": {
      "name": "content-hub-cms-preview",
      "vars": {
        "APP_ENV": "preview"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    }
  }
}
