{
  "name": "content-hub-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Content publishing CMS foundation built with Next.js App Router.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.mjs",
    "start": "next start",
    "lint": "eslint",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "preview:check": "npm run build:vinext && vinext-cloudflare deploy --env preview --dry-run",
    "deploy:preview": "vinext-cloudflare deploy --env preview",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git@github-tranvanlanh-hub:tranvanlanh-hub/ForexCMS.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-d1": "^6.12.0",
    "@prisma/client": "6.12.0",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prisma": "6.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  }
}
